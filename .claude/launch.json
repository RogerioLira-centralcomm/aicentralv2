{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "flask",
      "runtimeExecutable": ".venv/bin/flask",
      "runtimeArgs": [
        "--app",
        "run:app",
        "run",
        "--port",
        "5050"
      ],
      "port": 5050
    },
    {
      "name": "flask-studio",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "STUDIO_URL=http://studio.localhost:5050",
        ".venv/bin/flask",
        "--app",
        "run:app",
        "run",
        "--port",
        "5050"
      ],
      "port": 5050
    }
  ]
}
