# Configurações do Banco de Dados PostgreSQL
# Smart Planner e ERP compartilham centralp (não use aicentral_db local para este módulo)
DB_HOST=212.85.13.233
DB_PORT=123
DB_NAME=centralp
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Chave Secreta do Flask (gere uma aleatória para produção)
SECRET_KEY=sua_chave_secreta_aqui
# Fernet para criptografar segredos em Integrações (Google, OpenRouter, Higgsfield, D4Sign)
# D4Sign não usa variáveis de ambiente: token e crypt key ficam só no banco.
# INTEGRATION_CREDENTIALS_KEY=

# Sessão persistente: o login permanece neste dispositivo (dias).
SESSION_LIFETIME_DAYS=365
# SESSION_COOKIE_SECURE=true

# API Key do OpenRouter — reserva se Integrações > OpenRouter ainda não tiver chave no banco
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
# Agente CentralX — chat operacional do ERP (não é o default das mesas de Labs)
AGENT_OPENROUTER_MODEL=openai/gpt-4o-mini
# Studio: diretor principal direto na OpenAI e redundância via OpenRouter.
# CREATIVE_STUDIO_DIRECTOR_MODEL=gpt-5-nano
# CREATIVE_STUDIO_DIRECTION_FALLBACK_MODEL=openai/gpt-4o-mini
# Modelagem de criativos — família GPT-5 (OpenRouter)
# DESIGN_SYSTEM_ADS_COMPOSE_MODEL=openai/gpt-5-mini
# DESIGN_SYSTEM_ADS_MODEL=openai/gpt-5-nano
# CREATIVE_FORMAT_MOCKUP_MODEL=openai/gpt-5-nano
# CREATIVE_FORMAT_SWAP_READ_MODEL=openai/gpt-5-nano
# CREATIVE_FORMAT_ROUTER_MODEL=openai/gpt-5-nano
# CREATIVE_FORMAT_ENGINEER_MODEL=openai/gpt-5.4
# Studio de Treinamentos — agente isolado da Imersão
TRAINING_AGENT_MODEL=anthropic/claude-sonnet-4.5
TRAINING_RESEARCH_MODEL=perplexity/sonar-pro
AGENT_TEMPERATURE=0.15
AGENT_TOP_P=0.9
AGENT_TOP_K=40
AGENT_FREQUENCY_PENALTY=0.1
AGENT_PRESENCE_PENALTY=0.0
# PDF: cloudflare-ai (econômico), mistral-ocr (documentos complexos) ou native
AGENT_PDF_ENGINE=cloudflare-ai
# OCR da Base Global Cadu: processamento Python + OpenAI multimodal econômico.
# O resultado é salvo como rascunho; embeddings não são gerados por este fluxo.
RAG_PDF_OCR_MODEL=gpt-5-mini
RAG_PDF_OCR_BATCH_PAGES=8

# URL base da aplicação (para URLs de imagens acessíveis externamente)
# Desenvolvimento:
BASE_URL=http://localhost:5000
# Produção (exemplo — domínio público HTTPS, usado para audioUrl do Wasender):
# BASE_URL=https://ai.centralcomm.media
# URLs canônicas da família Cadu
CENTRALX_URL=https://ai.centralcomm.media
CADU_URL=https://cadu.centralcomm.media
STUDIO_URL=https://studio.centralcomm.media
SKILLS_URL=https://skills.centralcomm.media
PLANNER_URL=https://planner.centralcomm.media
CONNECT_URL=https://reports.centralcomm.media
WORKSPACE_URL=https://workspace.centralcomm.media
AUTH_URL=https://auth.centralcomm.media
# Rollout seguro da família Cadu. Publicação inicial deve manter as três
# capacidades mutáveis desabilitadas; habilite em etapas após as migrações e
# o teste autenticado em produção.
CADU_FAMILY_ENABLED=0
CADU_FAMILY_WRITES_ENABLED=0
CADU_FAMILY_CHAT_ENABLED=1
CADU_CHAT_WORKER_ENABLED=0
CADU_BRAND_AUDIT_WORKER_ENABLED=0
# Conversations V2: configure each runtime separately. During migration,
# empty mode-specific values use CADU_CONVERSATIONS_V2_DIFY_URL/KEY.
CADU_WORKSPACE_ASSET_VERSION=29
CADU_CONVERSATIONS_V2_DIFY_URL=
CADU_CONVERSATIONS_V2_DIFY_KEY=
CADU_DIFY_FAST_URL=
CADU_DIFY_FAST_KEY=
CADU_DIFY_ANALYST_URL=
CADU_DIFY_ANALYST_KEY=
CADU_DIFY_OPERATOR_URL=
CADU_DIFY_OPERATOR_KEY=
CADU_DIFY_API_KEY=
CADU_DIFY_BASE_URL=https://api.dify.ai/v1
# Origem completa usada apenas para resolver caminhos relativos de anexos
# históricos. Deixe vazio até validar a origem e o diretório antigos.
CADU_LEGACY_ASSET_BASE_URL=
# Diretório em volume persistente para uploads privados de fontes de projetos.
# Em produção, aponte para um mount que sobreviva a releases/restarts.
# WORKSPACE_SOURCE_STORAGE_DIR=/var/lib/aicentralv2/workspace-sources
# Brevo: cadastre cada remetente no Brevo; Workspace é o remetente de acesso,
# convites, recuperação e redefinição de senha.
BREVO_API_KEY=
CADU_PRODUCT_EMAILS_ENABLED=1
BREVO_WORKSPACE_SENDER_NAME=Workspace CentralComm
BREVO_WORKSPACE_SENDER_EMAIL=contato@centralcomm.media
BREVO_STUDIO_SENDER_NAME=Studio CentralComm
BREVO_STUDIO_SENDER_EMAIL=contato@centralcomm.media
BREVO_PLANNER_SENDER_NAME=Planner CentralComm
BREVO_PLANNER_SENDER_EMAIL=contato@centralcomm.media
BREVO_SKILLS_SENDER_NAME=Skills CentralComm
BREVO_SKILLS_SENDER_EMAIL=contato@centralcomm.media
BREVO_CONNECT_SENDER_NAME=Connect CentralComm
BREVO_CONNECT_SENDER_EMAIL=contato@centralcomm.media
# SSO da família Cadu: Workspace, Connect, Studio, Skills e Planner.
# O nome novo evita colisão com cookies host-only instalados antes do SSO.
# Em produção, ProductionConfig já usa .centralcomm.media; só defina esta
# variável se o domínio da instalação for diferente.
# CADU_SESSION_COOKIE_DOMAIN=.centralcomm.media
# Endpoint PHP que recebe tickets emitidos pelo Auth (Python):
CADU_SSO_CONSUME_URL=https://cadu.centralcomm.media/sso-consume.php
# Fluxo Google atual: o PHP provisiona cliente, contato e plano Free.
CADU_GOOGLE_LOGIN_URL=https://cadu.centralcomm.media/google-login.php
# Áreas existentes/planejadas no Cadu PHP usadas pelo Workspace:
CADU_USERS_URL=https://cadu.centralcomm.media/usuarios
CADU_PLANS_URL=https://cadu.centralcomm.media/planos
CADU_CREDITS_URL=https://cadu.centralcomm.media/creditos
CADU_FINANCE_URL=https://cadu.centralcomm.media/financeiro
CADU_INTEGRATIONS_URL=https://cadu.centralcomm.media/integracoes
CADU_HELP_URL=https://cadu.centralcomm.media/ajuda

# Google OpenID Connect — login centralizado (não reutilizar Calendar/Meet)
# CentralX interno
GOOGLE_CENTRALX_CLIENT_ID=
GOOGLE_CENTRALX_CLIENT_SECRET=
GOOGLE_CENTRALX_REDIRECT_URI=https://auth.centralcomm.media/auth/google/callback
GOOGLE_CENTRALX_DOMAIN=centralcomm.media
# Cadu e família: credencial reservada para a futura troca do callback para Auth
GOOGLE_CADU_CLIENT_ID=
GOOGLE_CADU_CLIENT_SECRET=
GOOGLE_CADU_REDIRECT_URI=https://auth.centralcomm.media/auth/google/callback

# Google Workspace do cliente — Drive, Calendar/Meet, Analytics, Search Console e Ads
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=https://auth.centralcomm.media/auth/google/workspace/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Ambiente
AICENTRAL_ENV=development

# Imposto (%) usado em cotações novas e PIs novos (PI_IMPOSTO_PERCENTUAL ou IMPOSTO_PERCENTUAL)
PI_IMPOSTO_PERCENTUAL=17

# WasenderAPI (WhatsApp — página Comercial /whatsapp)
# API key da sessão Wasender (não expor no frontend)
WASENDER_API_KEY=
WASENDER_SESSION_ID=
# Webhook URL (produção — domínio precisa existir no DNS):
# https://aicentral.centralcomm.media/whatsapp/api/wasender/webhook
# Desenvolvimento local: use ngrok/cloudflare tunnel, ex.:
# https://SEU-TUNNEL.ngrok-free.app/whatsapp/api/wasender/webhook
# Copie o webhook_secret da sessão Wasender para cá (header X-Webhook-Signature)
WASENDER_WEBHOOK_SECRET=
WASENDER_API_BASE_URL=https://www.wasenderapi.com/api

# Trocar — vídeo Seedance 2.5 via OpenRouter
# CREATIVE_VIDEO_MODEL=bytedance/seedance-2.5
# CREATIVE_VIDEO_DRAFT_RESOLUTION=480p
# CREATIVE_VIDEO_PRODUCTION_RESOLUTION=720p
# CREATIVE_VIDEO_POLL_INTERVAL_SECONDS=5
# CREATIVE_VIDEO_MAX_DURATION_SECONDS=30
# CREATIVE_TTS_MODEL=google/gemini-3.1-flash-tts-preview

# Camadas V2 — Limpar fundo (Fase 6). Sem esta variável o botão fica desabilitado.
# Use Nano Banana Pro em 1K. Nunca recria pessoa, produto ou logo.
# CAMADAS_V2_ENABLED=false
# CAMADAS_V2_IMAGE_MODEL=google/gemini-3-pro-image
# CAMADAS_V2_IMAGE_RESOLUTION=1K

# Modelagem de criativos — GPT Image 2 via OpenRouter
# Rascunho (low/1K) vs publicável (high/2K). A montagem não muda com o tier.
# CREATIVE_IMAGE_DRAFT_ESTIMATED_COST_USD=0.006
# CREATIVE_IMAGE_PUBLISH_ESTIMATED_COST_USD=0.22
# USD_BRL_RATE=5.5
