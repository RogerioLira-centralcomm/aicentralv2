# Configurações do Banco de Dados PostgreSQL
# Smart Planner e ERP compartilham centralp (não use aicentral_db local para este módulo)
DB_HOST=212.85.13.233
DB_PORT=123
DB_NAME=centralp
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Chave Secreta do Flask (gere uma aleatória para produção)
SECRET_KEY=sua_chave_secreta_aqui
# Fernet para criptografar segredos em Integrações (Google, OpenRouter, Higgsfield, D4Sign)
# D4Sign não usa variáveis de ambiente: token e crypt key ficam só no banco.
# INTEGRATION_CREDENTIALS_KEY=

# Sessão persistente: o login permanece neste dispositivo (dias).
SESSION_LIFETIME_DAYS=365
# SESSION_COOKIE_SECURE=true

# API Key do OpenRouter — reserva se Integrações > OpenRouter ainda não tiver chave no banco
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
# Agente CentralX — chat operacional do ERP (não é o default das mesas de Labs)
AGENT_OPENROUTER_MODEL=openai/gpt-4o-mini
# Modelagem de criativos — família GPT-5 (OpenRouter)
# DESIGN_SYSTEM_ADS_COMPOSE_MODEL=openai/gpt-5-mini
# DESIGN_SYSTEM_ADS_MODEL=openai/gpt-5-nano
# CREATIVE_FORMAT_MOCKUP_MODEL=openai/gpt-5-nano
# CREATIVE_FORMAT_SWAP_READ_MODEL=openai/gpt-5-nano
# CREATIVE_FORMAT_ROUTER_MODEL=openai/gpt-5-nano
# CREATIVE_FORMAT_ENGINEER_MODEL=openai/gpt-5.4
# Studio de Treinamentos — agente isolado da Imersão
TRAINING_AGENT_MODEL=anthropic/claude-sonnet-4.5
TRAINING_RESEARCH_MODEL=perplexity/sonar-pro
AGENT_TEMPERATURE=0.15
AGENT_TOP_P=0.9
AGENT_TOP_K=40
AGENT_FREQUENCY_PENALTY=0.1
AGENT_PRESENCE_PENALTY=0.0
# PDF: cloudflare-ai (econômico), mistral-ocr (documentos complexos) ou native
AGENT_PDF_ENGINE=cloudflare-ai

# URL base da aplicação (para URLs de imagens acessíveis externamente)
# Desenvolvimento:
BASE_URL=http://localhost:5000
# Produção (exemplo — domínio público HTTPS, usado para audioUrl do Wasender):
# BASE_URL=https://ai.centralcomm.media

# Ambiente
AICENTRAL_ENV=development

# Imposto (%) usado em cotações novas e PIs novos (PI_IMPOSTO_PERCENTUAL ou IMPOSTO_PERCENTUAL)
PI_IMPOSTO_PERCENTUAL=17

# WasenderAPI (WhatsApp — página Comercial /whatsapp)
# API key da sessão Wasender (não expor no frontend)
WASENDER_API_KEY=
WASENDER_SESSION_ID=
# Webhook URL (produção — domínio precisa existir no DNS):
# https://aicentral.centralcomm.media/whatsapp/api/wasender/webhook
# Desenvolvimento local: use ngrok/cloudflare tunnel, ex.:
# https://SEU-TUNNEL.ngrok-free.app/whatsapp/api/wasender/webhook
# Copie o webhook_secret da sessão Wasender para cá (header X-Webhook-Signature)
WASENDER_WEBHOOK_SECRET=
WASENDER_API_BASE_URL=https://www.wasenderapi.com/api

# Modelagem de criativos — GPT Image 2 via OpenRouter
# Rascunho (low/1K) vs publicável (high/2K). A montagem não muda com o tier.
# CREATIVE_IMAGE_DRAFT_ESTIMATED_COST_USD=0.006
# CREATIVE_IMAGE_PUBLISH_ESTIMATED_COST_USD=0.22
# USD_BRL_RATE=5.5
