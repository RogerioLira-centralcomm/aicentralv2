[Unit]
Description=AIcentralv2 Flask Application
After=network.target

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/var/www/aicentralv2
Environment="PATH=/var/www/aicentralv2/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="AICENTRAL_ENV=production"
# O systemd já supervisiona o processo principal. Não use pidfile: um arquivo
# remanescente após restart/kill faz o Gunicorn recusar a próxima inicialização.
ExecStart=/var/www/aicentralv2/venv/bin/gunicorn --bind 127.0.0.1:8001 --workers 4 --timeout 120 --access-logfile /var/www/aicentralv2/logs/access.log --error-logfile /var/www/aicentralv2/logs/error.log run:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
