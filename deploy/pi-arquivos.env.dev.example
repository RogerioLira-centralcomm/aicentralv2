# =============================================================================
# PI — arquivos (.env no PC Windows / dev local)
# Copie ESTE BLOCO para o .env do projeto. Não use caminho Windows para pastas.
# Acesso humano: sempre pela URL logada no servidor publicado, nunca Explorer.
# =============================================================================

PI_PASTAS_BACKEND=local
PI_FILES_SERVER_ONLY=true

# NÃO defina no dev (grava no servidor, não no PC):
# PI_UPLOAD_ROOT=
# PI_UPLOAD_REMOTE_SSH=
# PI_STORAGE_SSH_DEV=

PI_MAKE_INVITES_ENABLED=false
PI_MAKE_CONFIGURACAO_ENABLED=false
PI_MAKE_ANDAMENTO_ENABLED=false

# URLs Make legado podem permanecer no .env; com backend local + flags off não são chamados.

# Teste de pasta no servidor (root com chave SSH do PC):
# PI_VERIFY_SERVER_SSH=root@ai.centralcomm.media
# python scripts/test_pi_primeiro_lista.py --servidor

# -------- Verificar após deploy (PowerShell, não vai no .env commitado) --------
# $env:PI_VERIFY_BASE_URL="https://ai.centralcomm.media"
# $env:PI_VERIFY_EMAIL="seu@centralcomm.media"
# $env:PI_VERIFY_PASSWORD="***"
# $env:PI_VERIFY_ID_PI="12345"
# python scripts/verify_pi_storage.py --remote