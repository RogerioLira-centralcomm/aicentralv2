# =============================================================================
# PI — arquivos (.env no SERVIDOR Linux, junto ao gunicorn)
# Mesclar estas linhas no .env de produção em /var/www/aicentralv2
# Disco real: PI_UPLOAD_ROOT abaixo. Equipe acessa só pela app (login).
# =============================================================================

PI_PASTAS_BACKEND=local
PI_FILES_SERVER_ONLY=false

# Caminho Linux onde o gunicorn grava (obrigatório em produção)
PI_UPLOAD_ROOT=/var/www/aicentralv2/instance/uploads/pi

# Não use no servidor:
# PI_UPLOAD_REMOTE_SSH=
# PI_STORAGE_SSH_DEV=

PI_MAKE_INVITES_ENABLED=false
PI_MAKE_CONFIGURACAO_ENABLED=false
PI_MAKE_ANDAMENTO_ENABLED=false

# BASE_URL pública do site (links de arquivo no e-mail / portal)
# BASE_URL=https://ai.centralcomm.media

# Auditoria opcional (TI, SSH no servidor — não é fluxo da equipe):
# ls -la /var/www/aicentralv2/instance/uploads/pi/<codigo_pi_cc>__<id_pi>/