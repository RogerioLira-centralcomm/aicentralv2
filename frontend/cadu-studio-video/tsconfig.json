{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"dom",
			"dom.iterable",
			"esnext"
		],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"paths": {
			"@/*": [
				"./opencut/*"
			],
			"next/image": [
				"./shims/next-image.tsx"
			],
			"next/link": [
				"./shims/next-link.tsx"
			],
			"next/navigation": [
				"./shims/next-navigation.ts"
			],
			"next-themes": [
				"./shims/next-themes.tsx"
			]
		}
	},
	"include": [
		"opencut",
		"cadu",
		"shims"
	]
}
