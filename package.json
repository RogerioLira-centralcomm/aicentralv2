{
  "name": "aicentralv2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i ./aicentralv2/static/css/tailwind/input.css -o ./aicentralv2/static/css/tailwind/output.css --watch",
    "build:vanilla": "tailwindcss -c ./tailwind.config.js -i ./aicentralv2/static/css/tailwind/input.css -o ./aicentralv2/static/css/tailwind/output.css --minify",
    "build:legacy": "tailwindcss -c ./tailwind.legacy.config.js -i ./aicentralv2/static/css/tailwind/input.css -o ./aicentralv2/static/css/tailwind/output-legacy.css --minify",
    "build:artifact": "tailwindcss -c ./tailwind.artifact.config.js -i ./aicentralv2/static/css/tailwind/artifact.input.css -o ./aicentralv2/static/css/tailwind/artifact.css --minify",
    "build": "npm run build:vanilla && npm run build:legacy && npm run build:artifact && npm run build:studio && npm run build:conversations && npm run build:auth && npm run build:editor",
    "build:conversations": "vite build --config vite.conversations.config.mjs",
    "build:auth": "vite build --config vite.auth.config.mjs",
    "test:workspace-layout": "node tests/frontend/cadu-workspace-layout.test.cjs",
    "build:editor": "vite build --config vite.studio-editor.config.mjs",
    "dev:conversations": "vite --config vite.conversations.config.mjs",
    "build:studio": "tailwindcss -c ./tailwind.studio.config.js -i ./aicentralv2/static/css/tailwind/video-studio.input.css -o ./aicentralv2/static/css/video-studio.css --minify"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.22",
    "postcss": "^8.5.25",
    "playwright": "1.62.1",
    "tailwindcss": "^3.4.14",
    "vite": "^6.1.0"
  },
  "overrides": {
    "nanoid": ">=3.3.17"
  }
}
